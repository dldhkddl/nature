# 이 파일을 복사해서 .dev.vars 로 저장하고 실제 값을 채워 넣으세요.
# .dev.vars 는 git에 올라가지 않습니다 (로컬 전용).
#
# 로컬 개발(`npm run dev`)에서는 이 파일이 자동으로 로드됩니다.
# 실제 배포 환경에서는 호스팅 플랫폼의 환경변수/시크릿 설정에
# 동일한 이름으로 값을 등록해 주세요.

# 네이버 커머스API센터(https://apicenter.commerce.naver.com/)에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 원산지 코드 (기본값 01 = 국산)
NAVER_ORIGIN_AREA_CODE=00

# A/S 전화번호 및 안내 문구
NAVER_AS_PHONE=
NAVER_AS_GUIDE=구매 후 문의사항은 판매자에게 연락해 주세요.

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ── 쿠팡 Open API ──────────────────────────────────────────────
# Wing > 판매자정보 > 오픈API 키 발급/관리 에서 발급
# 넣어두면 상품명으로 쿠팡 카테고리를 자동 추천받습니다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 카페24 Admin API (developers.cafe24.com 에서 앱 등록 후 발급)
# OAuth 인증이라 Redirect URI를 https://<배포주소>/api/cafe24/oauth/callback 으로 등록해야 합니다.
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
